RECOUP_SUPABASE_URL=https://your-project.supabase.co
RECOUP_SUPABASE_KEY=eyJ...              # anon/public key
RECOUP_SUPABASE_SERVICE_KEY=eyJ...       # service role key (server-side only, never expose)
